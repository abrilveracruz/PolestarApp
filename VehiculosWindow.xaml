<Window x:Class="PolestarApp.VehiculosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Polestar — Vehículos"
        Height="748"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0B">

    <Grid Background="#0B0B0B">

        <Rectangle Height="80"
                   VerticalAlignment="Top"
                   Fill="#151515"/>

        <TextBlock Text="POLESTAR"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Margin="30,25,0,0"/>

        <Button Content="INICIO"
                Width="100"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,40,0"
                Background="#151515"
                BorderBrush="#151515"
                Foreground="White"
                FontWeight="Bold"
                Click="BtnInicio_Click"/>
        
        <Button Content="LOGIN"
        Width="100"
        Height="40"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,20,150,0"
        Background="#151515"
        BorderBrush="#151515"
        Foreground="White"
        FontWeight="Bold"
        Click="BtnLogin_Click"/>


        <TextBlock Text="NUESTROS VEHÍCULOS"
                   Foreground="White"
                   FontSize="32"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,115,0,0"/>

        <TextBlock Text="Descubre nuestra gama de vehículos eléctricos"
                   Foreground="#B8B8B8"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,165,0,0"/>

        <ScrollViewer Margin="40,220,40,30"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <UniformGrid Columns="3">

                <StackPanel Margin="12">
                    <Border Background="#151515"
                            BorderBrush="#2A2A2A"
                            BorderThickness="1"
                            Padding="12">
                        <Image Source="Images/polestar4.png"
                               Height="180"
                               Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="POLESTAR 4"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="4,12,0,0"/>
                    <TextBlock Text="Desde 65.900 €"
                               Foreground="#B8B8B8"
                               FontSize="15"
                               Margin="4,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="12">
                    <Border Background="#151515"
                            BorderBrush="#2A2A2A"
                            BorderThickness="1"
                            Padding="12">
                        <Image Source="Images/Polestar3.2.png"
                               Height="180"
                               Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="POLESTAR 3"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="4,12,0,0"/>
                    <TextBlock Text="Desde 59.000 €"
                               Foreground="#B8B8B8"
                               FontSize="15"
                               Margin="4,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="12">
                    <Border Background="#151515"
                            BorderBrush="#2A2A2A"
                            BorderThickness="1"
                            Padding="12">
                        <TextBlock Text="PRÓXIMAMENTE"
                                   Foreground="#B8B8B8"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Height="180"
                                   TextAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MÁS MODELOS"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="4,12,0,0"/>
                    <TextBlock Text="Próximamente"
                               Foreground="#B8B8B8"
                               FontSize="15"
                               Margin="4,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="12">
                    <Border Background="#151515"
            BorderBrush="#2A2A2A"
            BorderThickness="1"
            Padding="12">
                        <Image Source="Images/polestar2.png"
               Height="180"
               Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="POLESTAR 2"
               Foreground="White"
               FontSize="19"
               FontWeight="Bold"
               Margin="4,12,0,0"/>
                    <TextBlock Text="Oferta desde 43.200 €"
               Foreground="#B8B8B8"
               FontSize="15"
               Margin="4,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="12">
                    <Border Background="#151515"
             BorderBrush="#2A2A2A"
             BorderThickness="1"
             Padding="12">
                        <Image Source="Images/polestar5.png"
                Height="180"
                Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="POLESTAR 5"
                Foreground="White"
                FontSize="19"
                FontWeight="Bold"
                Margin="4,12,0,0"/>
                    <TextBlock Text="Desde 121.900 €"
                Foreground="#B8B8B8"
                FontSize="15"
                Margin="4,5,0,0"/>
                </StackPanel>

            </UniformGrid>

        </ScrollViewer>

    </Grid>
</Window>