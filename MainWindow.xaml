<Window x:Class="PolestarApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolestarApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="Polestar_España" Width="1200" Height="748" Loaded="Polestar_España_Loaded">
        <Rectangle x:Name="FondoPrincipal" HorizontalAlignment="Left" Height="748" VerticalAlignment="Top" Width="1200" Fill="#FF0B0B0B">
            <Rectangle.Stroke>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF0B0B0B" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Stroke>
        </Rectangle>
        <Rectangle x:Name="BArra_Navegación" HorizontalAlignment="Left" Height="80" Stroke="#FF151515" VerticalAlignment="Top" Width="1200" Fill="#FF151515"/>
        <TextBlock x:Name="LogoPolestar" HorizontalAlignment="Left" Height="30" Margin="30,25,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="138" Foreground="White" FontWeight="Bold" FontSize="24"><Run Language="ca-es" Text="POLESTAR"/><LineBreak/><Run Language="ca-es"/></TextBlock>
        <Button x:Name="BtnInicio" Content="INICIO" HorizontalAlignment="Left" Height="40" Margin="236,25,0,0" VerticalAlignment="Top" Width="100" Background="#FF151515" BorderBrush="#FF151515" Foreground="White" FontWeight="Bold"/>
        <Button x:Name="BtnVehículos" Content="VEHÍCULOS" HorizontalAlignment="Left" Height="40" Margin="377,25,0,0" VerticalAlignment="Top" Width="100" Background="#FF151515" BorderBrush="#FF151515" Foreground="White" FontWeight="Bold"/>
        <Button x:Name="BtnLogin" Content="LOGIN" HorizontalAlignment="Left" Height="40" Margin="537,25,0,0" VerticalAlignment="Top" Width="100" Background="#FF151515" BorderBrush="#FF151515" Foreground="White" FontWeight="Bold" Click="BtnLogin_Click"/>
        <TextBlock x:Name="TítuloPrincipal" HorizontalAlignment="Left" Height="63" Margin="200,90,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="731" FontSize="36" FontWeight="Bold" Foreground="White" Opacity="0"><Run Language="ca-es" Text="DESCUBRE EL FUTURO"/></TextBlock>
        <TextBlock x:Name="SubtítuloPrincipal" HorizontalAlignment="Center" Height="78" Margin="0,150,5,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="751" FontSize="18" Foreground="#FFB8B8B8" FontFamily="Sylfaen"><Run Language="ca-es" Text="Movilidad eléctrica.   Diseño.   Tecnología"/></TextBlock>
        <Button x:Name="BtnVerVehículos" Content="VER VEHÍCULOS" Height="45" Margin="280,189,0,0" VerticalAlignment="Top" Width="180" Foreground="#FF0B0B0B" BorderBrush="White" FontWeight="Bold" HorizontalAlignment="Left" Click="BtnVehiculos_CLick"/>
        <TextBlock x:Name="TituloModelos" HorizontalAlignment="Left" Height="60" Margin="181,270,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="174" FontSize="14" FontWeight="Bold" Foreground="White"><Run Language="ca-es" Text="MODELOS DESTACADOS"/></TextBlock>
        <Border Background="#151515"
        BorderBrush="#2A2A2A"
        BorderThickness="1"
        CornerRadius="4"
        Padding="12"
        Margin="40,0,40,0"
        VerticalAlignment="Bottom"
        Height="65">
            <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
                <TextBlock Text="OFERTA ESPECIAL"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="0,0,20,0"/>
                <TextBlock Text="Descubre las ventajas de la movilidad eléctrica"
                   Foreground="#CCCCCC"
                   FontSize="14"
                   VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <Rectangle x:Name="TarjetaPolestar4" HorizontalAlignment="Left" Height="118" Margin="54,308,0,0" Stroke="#FF2A2A2A" VerticalAlignment="Top" Width="169">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Images/polestar4.png"/>
            </Rectangle.Fill>

        </Rectangle>
        <Rectangle x:Name="ImagenPolestar4" HorizontalAlignment="Left" Height="82" Margin="54,292,0,0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="Images/polestar4.png" Stretch="UniformToFill"/>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock x:Name="NombrePolestar4" HorizontalAlignment="Left" Height="50" Margin="59,379,0,0" TextWrapping="Wrap" Text="Polestar 4" VerticalAlignment="Top" Width="164" FontWeight="Bold" Foreground="White" FontSize="13"/>
        <TextBlock x:Name="PrecioPolestar4" HorizontalAlignment="Left" Height="25" Margin="59,404,0,0" TextWrapping="Wrap" Text="Desde 65.900 €" VerticalAlignment="Top" Width="87" Foreground="White"/>
        <Rectangle x:Name="TarjetaPolestar3" HorizontalAlignment="Left" Height="161" Margin="291,287,0,0" Stroke="#FF111010" VerticalAlignment="Top" Width="169" OpacityMask="Black">
            <Rectangle.Fill>
                <ImageBrush ImageSource="Images/Polestar3.2.png" Stretch="Uniform"/>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock HorizontalAlignment="Left" Height="21" Margin="298,380,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="169" FontWeight="Bold" Foreground="White" FontSize="13"><Run Text="Polestar 3"/><LineBreak/><Run/><LineBreak/></TextBlock>
        <TextBlock x:Name="PrecioPolestar4_Copiar" HorizontalAlignment="Left" Height="25" Margin="298,404,0,0" TextWrapping="Wrap" Text="Desde 59.000 €" VerticalAlignment="Top" Width="87" Foreground="White"/>
        <Grid x:Name="PantallaLogin" Visibility="Collapsed">
            <TextBlock Text="INICIAR SESIÓN" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,150,0,0"/>
            <TextBox x:Name="TxtUsuario" Width="300" Height="40" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,210,0,0" Text="Usuario" />
            <PasswordBox x:Name="TxtContraseña" Width="300" Height="40" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,260,0,0" />
            <Button x:Name="BtnIniciarSesion"
                    Click="BtnInicarSesion_Click"
                    Content="INICIAR SESION"
                    Width="300"
                    Height="45"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,320,0,0" 
                    FontWeight="Bold"
                    />
        </Grid>

        <TextBlock x:Name="TxtErrorLogin"
                       Text="Usuario o contraseña incorrecta"
                       Foreground="#FF5555"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,380,0,0"
                       Visibility="Collapsed" />


        </Grid>
</Window>

    
    