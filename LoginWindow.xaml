<Window x:Class="PolestarApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolestarApp"
        mc:Ignorable="d"
        Title="Polestar - Iniciar sesión" Height="600" Width="500">
    <Grid Background="#0B0B0B">
        <TextBlock Text="POLESTAR"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="30,25,0,0"/>
        <Button Content="INICIO"
                Width="100"
                Height="35"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,30,0"
                Background="#151515"
                BorderBrush="#2A2A2A"
                Foreground="White"
                FontWeight="Bold"
                Click="BtnInicio_Click"/>
        
        <Button Content="VEHÍCULOS"
                Width="110"
                Height="35"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,145,0"
                Background="#151515"
                BorderBrush="#2A2A2A"
                Foreground="White"
                FontWeight="Bold"
                Click="BtnVehiculos_Click"/>
        
        <TextBlock Text="INICIAR SESIÓN"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,70,0,0" />
        <TextBox x:Name="TxtUsuario"
                 Width="300"
                 Height="40"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,160,0,0" />
        <PasswordBox x:Name="TxtContrasena"
                     Width="300"
                     Height="40"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="0,220,0,0" />
        <Button x:Name="BtnIniciarSesion"
                Click="BtnIniciarSesion_Click"
                Content="INICIAR SESIÓN"
                Width="300"
                Height="45"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,290,0,0"
                FontWeight="Bold" />
        <TextBlock x:Name="TxtErrorLogin"
                   Text="Usuario o contraseña incorrectos"
                   Foreground="#E53935"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,350,0,0"
                   Visibility="Collapsed" />




    </Grid>
</Window>
